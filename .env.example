# ai-research-radar environment configuration
# Copy to `.env` (git-ignored) or export in your shell / CI secrets.
# The tool NEVER requires any of these: it fully works without credentials.

# --- GitHub ---------------------------------------------------------------
# Optional. Raises the GitHub API limit from 60 req/h (anonymous) to 5000 req/h.
# Scope: no scopes needed for public repositories ("public_repo" is enough).
GITHUB_TOKEN=

# --- LLM providers (all optional) -----------------------------------------
# Which provider to use: auto | none | openai | anthropic | gemini | openai-compatible
#   auto  = use the first provider whose API key is present (default)
#   none  = disable LLM features entirely (rule-based classification + extractive summaries)
RADAR_LLM_PROVIDER=auto
# Override the provider's default model (leave empty for a sensible default)
RADAR_LLM_MODEL=

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# "openai-compatible" targets any OpenAI-style chat completions API:
# Ollama (http://localhost:11434/v1), vLLM, LM Studio, OpenRouter, Groq ...
# Example — DeepSeek (OpenAI-compatible):
#   OPENAI_COMPATIBLE_BASE_URL=https://api.deepseek.com/v1
#   OPENAI_COMPATIBLE_API_KEY=sk-...
#   RADAR_LLM_MODEL=deepseek-chat
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=

# --- Runtime knobs ---------------------------------------------------------
# Allow fetching private/loopback URLs (needed only for local integration testing).
# Leave unset in production; it exists so tests can run a local HTTP server.
# RADAR_ALLOW_PRIVATE=1
